# ============================================================
# RepoSketch - The Astral Cartographer
# Backend Environment Variables
#
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ============================================================

# ---- Server Configuration ----
PORT=3001
NODE_ENV=development

# ---- GitHub API ----
# Personal Access Token for cloning private repos and higher rate limits
# Generate at: https://github.com/settings/tokens
# Required scopes: repo (for private), public_repo (for public only)
GITHUB_TOKEN=your_github_personal_access_token_here

# ---- Repository Storage ----
# Directory where cloned repositories are temporarily stored
# This path is relative to the backend root
TEMP_REPO_DIR=./temp_repos

# Maximum size (in MB) allowed for a repository clone
MAX_REPO_SIZE_MB=500

# Auto-cleanup cloned repos after analysis (true/false)
AUTO_CLEANUP=true

# ---- CORS Configuration ----
# Frontend origin(s) allowed to access the API
# Comma-separated for multiple origins
CORS_ORIGINS=http://localhost:5173

# ---- Rate Limiting ----
# Max requests per window per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---- Analysis Settings ----
# Maximum depth for dependency graph traversal
MAX_DEPENDENCY_DEPTH=10

# Maximum number of files to parse per repo
MAX_FILES_TO_PARSE=2000

# File size limit for AST parsing (in KB)
MAX_FILE_SIZE_KB=512

# ---- Logging ----
LOG_LEVEL=info
# Options: error | warn | info | http | verbose | debug | silly
